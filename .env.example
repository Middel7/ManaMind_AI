# Copier ce fichier en .env et remplir les valeurs
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore)

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Format : postgresql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=postgresql://manamind:motdepasse@localhost:5432/manamind

# ── Exemples selon la configuration ────────────────────────────────────────────
# Installation locale standard :
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manamind
#
# Docker Compose (voir docs/DATABASE_SETUP.md) :
#   DATABASE_URL=postgresql://manamind:manamind@localhost:5432/manamind
#
# PostgreSQL sur un port personnalisé :
#   DATABASE_URL=postgresql://user:pass@localhost:5433/manamind

# ── Sécurité ───────────────────────────────────────────────────────────────────
# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-string

# Activer le flag Secure sur les cookies (mettre à true en production HTTPS)
HTTPS_ENABLED=false

# Activer les tracebacks dans les réponses d'erreur 500 (dev uniquement)
DEBUG=false

# ── Serveur ────────────────────────────────────────────────────────────────────
# Port d'écoute du serveur uvicorn
PORT=8080

# ── CORS ───────────────────────────────────────────────────────────────────────
# Origines autorisées (séparées par virgule)
CORS_ORIGINS=http://localhost:8080

# ── Sentry — monitoring des erreurs ────────────────────────────────────────────
# Laisser vide pour désactiver Sentry (aucune dépendance réseau si absent)
SENTRY_DSN=
ENVIRONMENT=production
