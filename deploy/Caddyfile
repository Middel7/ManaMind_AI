manamind.eu, www.manamind.eu {
    # TLS automatique via Let's Encrypt
    tls {
        protocols tls1.2 tls1.3
    }

    # Caddy tourne dans son propre conteneur : « localhost » y designerait
    # Caddy lui-meme. On vise le service applicatif par son nom sur le reseau
    # Docker, et le port interne du conteneur.
    reverse_proxy app:8080 {
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 10s
    }

    # Headers de sécurité supplémentaires (complète ceux du serveur)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Logs
    log {
        output file /var/log/caddy/manamind.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
