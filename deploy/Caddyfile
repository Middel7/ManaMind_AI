# Remplace ton-domaine.com par ton vrai domaine
ton-domaine.com {
    # TLS automatique via Let's Encrypt
    tls {
        protocols tls1.2 tls1.3
    }

    # Reverse proxy vers l'app FastAPI
    reverse_proxy localhost:8080 {
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 10s
    }

    # Headers de sécurité supplémentaires (complète ceux du serveur)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Logs
    log {
        output file /var/log/caddy/manamind.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
